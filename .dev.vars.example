# Local development only. These deterministic fixture keys are public and must
# never be copied into Cloudflare production secrets.
APP_ENV=development
SMS_PROVIDER=mock
DEV_OTP_CODE=123456

# Cloudflare's official always-pass Turnstile test credentials.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAMES=

PRIVACY_POLICY_VERSION=2026-09-03
LIVESTREAM_POLICY_VERSION=2026-09-03

# OpenAI-compatible moderation. Use a disposable local key here; never commit
# a real key. Missing or failed AI configuration is fail-open.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_API_KEY=

# Four distinct 32-byte development fixtures encoded as base64.
PHONE_HASH_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PHONE_ENCRYPTION_KEY=ERERERERERERERERERERERERERERERERERERERERERE=
OTP_HMAC_KEY=IiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiI=
RATE_LIMIT_HMAC_KEY=MzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzM=

# Dormant phone/OTP support retained for a possible future re-enable.
# Optional local PNVS integration test. Keep SMS_PROVIDER=mock for normal
# development; if testing PNVS locally, use non-production credentials and
# replace every placeholder below. Never commit real values.
# SMS_PROVIDER=alibaba_pnvs
# ALIBABA_ACCESS_KEY_ID=replace-with-non-production-access-key-id
# ALIBABA_ACCESS_KEY_SECRET=replace-with-non-production-access-key-secret
# ALIBABA_PNVS_SIGN_NAME=replace-with-pnvs-gift-sign-name
# ALIBABA_PNVS_TEMPLATE_CODE=replace-with-pnvs-gift-template-code
