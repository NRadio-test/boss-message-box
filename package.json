{
  "name": "boss-message-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check:visual": "node scripts/visual-check.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run check:contrast && pnpm run build",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply BOSS_MESSAGE_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply BOSS_MESSAGE_DB --remote"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
